import requests
import streamlit as st

# Page configuration
st.set_page_config(page_title="Live News Stream", page_icon="📰", layout="wide")

# Replace with your actual API key from newsapi.org
API_KEY = "YOUR_NEWS_API_KEY"
BASE_URL = "https://newsapi.org/v2/top-headlines"


@st.cache_data(ttl=600)
def fetch_news(category="general"):
  params = {"country": "us", "category": category, "apiKey": API_KEY}
  response = requests.get(BASE_URL, params=params)
  if response.status_code == 200:
    return response.json().get("articles", [])
  return []


st.title("🔴 Live Online News Stream")
st.write("Catch the latest headlines updated in real-time.")

# Sidebar category selection
category = st.sidebar.selectbox(
    "Choose Category",
    ["general", "business", "technology", "entertainment", "science", "sports"],
)

articles = fetch_news(category)

if not articles:
  st.warning(
      "Could not fetch news. Please check your API key or internet connection."
  )
else:
  for article in articles:
    cols = st.columns([1, 3])
    with cols[0]:
      if article.get("urlToImage"):
        st.image(article["urlToImage"], use_column_width=True)
    with cols[1]:
      st.subheader(article["title"])
      st.write(article["description"])
      st.markdown(f"[Read full article]({article['url']})", unsafe_allow_html=True)
    st.divider()
